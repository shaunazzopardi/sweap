//-- State: at_floor, target
//-- Inputs: signal

assume {
  eq target i0();
  ge at_floor i1();
  ge i10() at_floor;
}

always assume {
  ge signal i0();
  ge i10() signal;
  !(eq target i0()) -> eq signal i0();
}

always guarantee {
  ge at_floor i1(); /* INV */
  ge i10() at_floor; /* INV */
  !(eq signal i0()) && !(eq at_floor target) -> [target <- signal];
  eq signal i0() && !(eq at_floor target) -> [target <- target];
  eq at_floor target -> [target <- i0()];

  [at_floor <- at_floor] || [at_floor <- add at_floor i1()] || [at_floor <- sub at_floor i1()];

  eq target i1() -> F (eq at_floor i1());
  eq target i2() -> F (eq at_floor i2());
  eq target i3() -> F (eq at_floor i3());
  eq target i4() -> F (eq at_floor i4());
  eq target i5() -> F (eq at_floor i5());
  eq target i6() -> F (eq at_floor i6());
  eq target i7() -> F (eq at_floor i7());
  eq target i8() -> F (eq at_floor i8());
  eq target i9() -> F (eq at_floor i9());
  eq target i10() -> F (eq at_floor i10());
}
