//-- State: at_floor, target
//-- Inputs: signal

assume {
  eq target i0();
  ge at_floor i1();
  ge i50() at_floor;
}

always assume {
  ge signal i0();
  ge i50() signal;
  !(eq target i0()) -> eq signal i0();
}

always guarantee {
  ge at_floor i1(); /* INV */
  ge i10() at_floor; /* INV */
  !(eq signal i0()) && !(eq at_floor target) -> [target <- signal];
  eq signal i0() && !(eq at_floor target) -> [target <- target];
  eq at_floor target -> [target <- i0()];

  [at_floor <- at_floor] || [at_floor <- add at_floor i1()] || [at_floor <- sub at_floor i1()];

  eq target i1() -> F (eq at_floor i1());
  eq target i2() -> F (eq at_floor i2());
  eq target i3() -> F (eq at_floor i3());
  eq target i4() -> F (eq at_floor i4());
  eq target i5() -> F (eq at_floor i5());
  eq target i6() -> F (eq at_floor i6());
  eq target i7() -> F (eq at_floor i7());
  eq target i8() -> F (eq at_floor i8());
  eq target i9() -> F (eq at_floor i9());
  eq target i10() -> F (eq at_floor i10());
  eq target i11() -> F (eq at_floor i11());
  eq target i12() -> F (eq at_floor i12());
  eq target i13() -> F (eq at_floor i13());
  eq target i14() -> F (eq at_floor i14());
  eq target i15() -> F (eq at_floor i15());
  eq target i16() -> F (eq at_floor i16());
  eq target i17() -> F (eq at_floor i17());
  eq target i18() -> F (eq at_floor i18());
  eq target i19() -> F (eq at_floor i19());
  eq target i20() -> F (eq at_floor i20());
  eq target i21() -> F (eq at_floor i21());
  eq target i22() -> F (eq at_floor i22());
  eq target i23() -> F (eq at_floor i23());
  eq target i24() -> F (eq at_floor i24());
  eq target i25() -> F (eq at_floor i25());
  eq target i26() -> F (eq at_floor i26());
  eq target i27() -> F (eq at_floor i27());
  eq target i28() -> F (eq at_floor i28());
  eq target i29() -> F (eq at_floor i29());
  eq target i30() -> F (eq at_floor i30());
  eq target i31() -> F (eq at_floor i31());
  eq target i32() -> F (eq at_floor i32());
  eq target i33() -> F (eq at_floor i33());
  eq target i34() -> F (eq at_floor i34());
  eq target i35() -> F (eq at_floor i35());
  eq target i36() -> F (eq at_floor i36());
  eq target i37() -> F (eq at_floor i37());
  eq target i38() -> F (eq at_floor i38());
  eq target i39() -> F (eq at_floor i39());
  eq target i40() -> F (eq at_floor i40());
  eq target i41() -> F (eq at_floor i41());
  eq target i42() -> F (eq at_floor i42());
  eq target i43() -> F (eq at_floor i43());
  eq target i44() -> F (eq at_floor i44());
  eq target i45() -> F (eq at_floor i45());
  eq target i46() -> F (eq at_floor i46());
  eq target i47() -> F (eq at_floor i47());
  eq target i48() -> F (eq at_floor i48());
  eq target i49() -> F (eq at_floor i49());
  eq target i50() -> F (eq at_floor i50());

}
