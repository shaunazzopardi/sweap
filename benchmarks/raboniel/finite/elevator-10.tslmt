//-- State: at_floor, target, q
//-- Inputs: inc, dooropen, env_target

//#LIA#

assume {
  eq at_floor i0();
  eq q i0();
}

always assume {
  eq dooropen i0() || eq dooropen i1();
  (ge env_target i0()) && (le env_target i10());
  G F (eq dooropen i0());
  G F (eq dooropen i1());
}

always guarantee {
  (eq q i0() && (eq dooropen i1())) -> ([target <- target] && [q <- i0()]);
  (eq q i0() && eq dooropen i0()) -> ([target <- env_target] && [q <- i1()]);

  (eq q i1()) -> [at_floor <- add at_floor i1()] || [at_floor <- sub at_floor i1()] || [at_floor <- at_floor];
  (eq q i1() && eq at_floor target) -> [q <- i0()];

  (eq dooropen i1()) -> [at_floor <- at_floor];

  G F (eq at_floor target);
  (ge at_floor i0()) && (le at_floor i10());
  (ge target i0()) && (le target i10());
}
