//-- State:  cc, x, y
//-- Inputs: e

assume{
    (eq x i0());
    (eq cc i0());
}

guarantee {

    // updates cc
    G ([cc <- i0()] || [cc <- i1()]);
    G ((eq cc i1()) -> [cc <- i1()]);

    // updates x
    G ( (eq cc i0()) -> [x <- add x ee] || [x <- sub x  ee]);
    G (!(eq cc i0()) -> [x <- add x i1()]);
    
    // objectives
    G ((eq cc i0()) -> (ge x i0()));
    G (!(eq cc i0()) -> F (le x (sub i0() i10000())));
}