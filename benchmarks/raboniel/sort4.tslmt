//-- State: a,b,c,d

always guarantee {
  ([a <- b] && [b <- a] && [cc <- cc] && [d <- d]) || // flip(a,b)
  ([b <- cc] && [cc <- b] && [a <- a] && [d <- d]) || // flip(b,c)
  ([cc <- d] && [d <- cc] && [a <- a] && [b <- b]) || // flip(c,d)
  ([a <- a] && [b <- b] && [cc <- cc] && [d <- d]);   // no-op
}

guarantee {
  F G (ge a b && ge b cc && ge cc d);
}
