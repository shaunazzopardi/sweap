//-- State: i_x, i_y loc
//-- Inputs: env_in_x, env_in_y

assume {
    (eq loc i0());
}

always guarantee{
    (eq loc i0()) -> ([loc <- i1()] && [i_x <- env_in_x] && [i_y <- env_in_y]);
    ((eq loc i1()) && (eq i_x i0()) && (eq i_y i0())) -> [loc <- i0()];

    ((eq loc i1()) && (! ((eq i_x i0()) && (eq i_y i0()))) && (le obstacle i0())) -> ([i_x <- i_x] && [i_y <- i_y]);
    ((eq loc i1()) && (! ((eq i_x i0()) && (eq i_y i0()))) && (gt obstacle i0())) -> ([i_x <- i_x] || [i_x <- (add i_x i1())] || [i_x <- (sub i_x i1())]);
    ((eq loc i1()) && (! ((eq i_x i0()) && (eq i_y i0()))) && (gt obstacle i0())) -> ([i_y <- i_y] || [i_y <- (add i_y i1())] || [i_y <- (sub i_y i1())]);
}

guarantee { (G F (le obstacle i0())) -> G F([loc  <- i0()]);}

