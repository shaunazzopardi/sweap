//-- State: cnt, con_room, env_room, q
//-- Inputs: env_cnt, room

same_room = (con_room <-> env_room);

assume {
    q;
    !env_room;
    !con_room;
}

always assume {
    ge env_cnt i0();
}

always guarantee {
  q -> ([cnt <- env_cnt] && [env_room <- room] && [q <- false]);

  (!q && (gt cnt i0()) && same_room) -> ([env_room <- env_room] && [cnt <- sub cnt i1()] && [q <- q]);

  (!q && (! same_room)) -> ([env_room <- env_room] && [cnt <- cnt] && [q <- q]);

   (!q && ((eq cnt i0())) && (same_room)) -> ([env_room <- env_room] && [q <- true]);

  ([con_room <- true] || [con_room <- false]);

  F q;
}
