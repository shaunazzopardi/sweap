//-- State:  numE, processs

MINELEMS = i64();

moreElems = (gt numE MINELEMS);
fewElems = (lt numE MINELEMS);
empty  = (le numE i0());

processing =  !(eq processs i0());

assume {
    (eq numE i0());
    !processing;
}

guarantee{

    G (ge numE i0());
    G ((eq processs i0()) || (eq processs i1()));

    // fill storage
    G (empty -> [numE <- add numE i1()] && ([processs <- i0()] || [processs <- i1()]));
    G (!empty && !processing -> [numE <- add numE i1()] && ([processs <- i0()] || [processs <- i1()]));

    // if more than MINE elements, remove one
    G (!empty && processing && moreElems -> [numE <- sub numE i1()] && [processs <- processs]);

    // if too few elems then stuck
    G (!empty && processing && fewElems -> [numE <- numE] && [processs <- processs]);

    // batch-processs remaining elements
    G (!empty && processing && !fewElems && !moreElems -> [numE <- i0()] && [processs <- i0()]);
    
    // infinitely often storage empty
    G F (empty);

}
