program unordered-visits-charging{
    STATES {
        q: init
    }

    ENVIRONMENT EVENTS{
    }

    CONTROLLER EVENTS{
        cx1, cx2, c1, c2, dx1, dx2
    }

    VALUATION{
        x: int := 0;
        dx: int := 0;
        charge: int := 60;
    }

    TRANSITIONS[completion=stutter]{
        q -> q [$ x := x if cx1 & cx2;
                  x := x + dx if cx1 & !cx2;
                  x := x + 1 if !cx1 & cx2;
                  x := x - 1 if !cx1 & !cx2;
                  charge := charge - 1 if c1 & c2;
                  charge := charge + 1 if !c1 & c2;
                  charge := charge if !c2;
                  dx := 1 if dx1 & dx2;
                  dx := -1 if !dx1 & dx2;
                  dx := dx if !dx2
                ]
    }

    SPECIFICATION{
        cx1 & cx2 & !c2 & dx2 &&
        (X G((x >= 50) -> ((!cx1 & !cx2 && !dx1 & dx2) || (cx1 & cx2 && !c1 & c2 && !dx2)))) &&

        (X G((x <= -70) -> ((!cx1 & cx2 && dx1 & dx2) || (cx1 & cx2 && !c1 & c2 && !dx2)))) &&

        (X G(!(x >= 50) && !(x <= -70) -> (cx1 & !cx2 & c1 & c2 && !dx2))) &&
        (G ((charge >= 0) && charge <= 150)) &&
        F (x >= 50) &&
        F (x <= -70)
    }
}
