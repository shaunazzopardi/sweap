program arbiter-det {
    STATES {
        q0 : init, q1
    }

    ENVIRONMENT EVENTS {
        i: integer
    }

    CONTROLLER EVENTS {
        finished
    }

    VALUATION {
        cnt : integer;
    }

    TRANSITIONS {
        q0 -> q1 [$ cnt := i;],
        q1 -> q1 [!finished $ cnt := cnt - 1],
        q1 -> q0 [cnt == 0 & finished $]
    }

    SPECIFICATION {
        (cnt == 0) -> G(q1 -> F q0)
    }
}