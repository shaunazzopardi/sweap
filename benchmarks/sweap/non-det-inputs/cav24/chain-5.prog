program chain-4 {
    STATES {
        init_st : init, goal, sink, l1, l2, l3, l4, l5
    }

    ENVIRONMENT EVENTS {
        i: integer
    }

    CONTROLLER EVENTS {
        cinc, setc
    }

    VALUATION {
        x1 : int := 0;
        x2 : int := 0;
        x3 : int := 0;
        x4 : int := 0;
        x5 : int := 0;
        y : int := 0;
        c : int := 0;
    }

    TRANSITIONS {
        init_st -> goal [$ c := 0],
        sink -> sink [],
        goal -> sink [c == 1],
        goal -> l1 [c != 1 $ y := i; x1 := i],

        l1 -> l2 [x1 == 0 $ x2 := y],
        l1 -> l1 [x1 != 0 & cinc & !setc $ x1 := x1 + 1],
        l1 -> l1 [x1 != 0 & !cinc & !setc $ x1 := x1 - 1],
        l1 -> goal [x1 != 0 & setc $ c := 1],

        l2 -> l3 [x2 == 0 $ x3 := y],
        l2 -> l2 [x2 != 0 & cinc & !setc $ x2 := x2 + 1],
        l2 -> l2 [x2 != 0 & !cinc & !setc $ x2 := x2 - 1],
        l2 -> goal [x2 != 0 & setc $ c := 1],

        l3 -> l4 [x3 == 0 $ x4 := y],
        l3 -> l3 [x3 != 0 & cinc & !setc $ x3 := x3 + 1],
        l3 -> l3 [x3 != 0 & !cinc & !setc $ x3 := x3 - 1],
        l3 -> goal [x3 != 0 & setc $ c := 1],

        l4 -> l5 [x4 == 0 $ x4 := y],
        l4 -> l4 [x4 != 0 & cinc & !setc $ x4 := x4 + 1],
        l4 -> l4 [x4 != 0 & !cinc & !setc $ x4 := x4 - 1],
        l4 -> goal [x4 != 0 & setc $ c := 1],

        l5 -> goal [x5 == 0],
        l5 -> l5 [x5 != 0 & cinc & !setc $ x5 := x5 + 1],
        l5 -> l5 [x5 != 0 & !cinc & !setc $ x5 := x5 - 1],
        l5 -> goal [x5 != 0 & setc $ c := 1]
    }

    SPECIFICATION {
        G F goal
    }
}