// counters
state int x0
state int x1
state int x2
state int d

//input 
input int i

formula {

   assert G([d'=0] || [d'=1] || [d'=2])
   
   assume ([x0 = 0])
   assert G (![x1 = 10] -> ([x0' = x0 + 1] && (![d'=0] || [i > 1] || [i < -1]) || [x0' = x0 + 1 + i] && [d'=0]))
   assert G ([x1 = 10] -> [x0' = 0])

   assume ([x1 = 0])
   assert G (![x2 = 10] -> ([x1' = x1 + 1] && (![d'=1] || [i > 1] || [i < -1]) || [x1' = x1 + 1 + i] && [d'=1])) 
   assert G ([x2 = 10] -> [x1' = 0])

   assume ([x2 = 0])
   assert G ([x2' = x2 + 1] && (![d'=2] || [i > 1] || [i < -1]) || [x2' = x2 + 1 + i] && [d'=2])
   
   assert F [x0 > 10]
 }
 