// counters
state int x0
state int x1
state int x2
state int x3
state int x4
state int x5
state int x6
state int x7
state int x8
state int x9
state int x10
state int d

//input 
input int i
 
 game Reachability from linit {
    loc linit 0
    loc l0 0
    loc l1 1
    

   from linit to l1 with (![x0 = 0] || ![x1 = 0] || ![x2 = 0] || ![x3 = 0] || ![x4 = 0] || ![x5 = 0] || ![x6 = 0] || ![x7 = 0] || ![x8 = 0] || ![x9 = 0] || ![x10 = 0]) 
   from linit to l0 with keep(x0 x1 x2 x3 x4 x5 x6 x7 x8 x9 x10)
    from l0 to l0 with (
    ([d' >= 0] && [d' <= 10])
    && (![x1 = 10] -> ([x0' = x0 + 1] && (![d'=0] || [i > 1] || [i < -1]) || [x0' = x0 + 1 + i] && [d'=0]))
    && ([x1 = 10] -> [x0' = 0])
    && (![x2 = 10] -> ([x1' = x1 + 1] && (![d'=1] || [i > 1] || [i < -1]) || [x1' = x1 + 1 + i] && [d'=1])) 
    && ([x2 = 10] -> [x1' = 0])
    && (![x3 = 10] -> ([x2' = x2 + 1] && (![d'=2] || [i > 1] || [i < -1]) || [x2' = x2 + 1 + i] && [d'=2])) 
    && ([x3 = 10] -> [x2' = 0])
    && (![x4 = 10] -> ([x3' = x3 + 1] && (![d'=3] || [i > 1] || [i < -1]) || [x3' = x3 + 1 + i] && [d'=3])) 
    && ([x4 = 10] -> [x3' = 0])
    && (![x5 = 10] -> ([x4' = x4 + 1] && (![d'=4] || [i > 1] || [i < -1]) || [x4' = x4 + 1 + i] && [d'=4])) 
    && ([x5 = 10] -> [x4' = 0])
    && (![x6 = 10] -> ([x5' = x5 + 1] && (![d'=5] || [i > 1] || [i < -1]) || [x5' = x5 + 1 + i] && [d'=5])) 
    && ([x6 = 10] -> [x5' = 0])
    && (![x7 = 10] -> ([x6' = x6 + 1] && (![d'=6] || [i > 1] || [i < -1]) || [x6' = x6 + 1 + i] && [d'=6])) 
    && ([x7 = 10] -> [x6' = 0])
    && (![x8 = 10] -> ([x7' = x7 + 1] && (![d'=7] || [i > 1] || [i < -1]) || [x7' = x7 + 1 + i] && [d'=7])) 
    && ([x8 = 10] -> [x7' = 0])
    && (![x9 = 10] -> ([x8' = x8 + 1] && (![d'=8] || [i > 1] || [i < -1]) || [x8' = x8 + 1 + i] && [d'=8])) 
    && ([x9 = 10] -> [x8' = 0])
    && (![x10 = 10] -> ([x9' = x9 + 1] && (![d'=9] || [i > 1] || [i < -1]) || [x9' = x9 + 1 + i] && [d'=9])) 
    && ([x10 = 10] -> [x9' = 0])
    && ([x10' = x10 + 1] && (![d'=10] || [i > 1] || [i < -1]) || [x10' = x10 + 1 + i] && [d'=10])     
    )
    from l0 to l1 with [x0 > 10]
    from l1 to l1 with true
    
}