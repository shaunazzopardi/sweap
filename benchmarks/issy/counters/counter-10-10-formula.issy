// counters
state int x0
state int x1
state int x2
state int x3
state int x4
state int x5
state int x6
state int x7
state int x8
state int x9
state int x10
state int d

//input 
input int i

formula {
    
    assert G ([d' = 0] || [d' = 1] || [d' = 2] || [d' = 3] || [d' = 4] || [d' = 5] || [d' = 6] || [d' = 7] || [d' = 8] || [d' = 9] || [d' = 10])

    assume ([x0 = 0])
    assert G (![x1 = 10] -> ([x0' = x0 + 1] && (![d'=0] || [i > 1] || [i < -1]) || [x0' = x0 + 1 + i] && [d'=0]))
    assert G ([x1 = 10] -> [x0' = 0])

    assume ([x1 = 0])
    assert G (![x2 = 10] -> ([x1' = x1 + 1] && (![d'=1] || [i > 1] || [i < -1]) || [x1' = x1 + 1 + i] && [d'=1])) 
    assert G ([x2 = 10] -> [x1' = 0])

    assume ([x2 = 0])
    assert G (![x3 = 10] -> ([x2' = x2 + 1] && (![d'=2] || [i > 1] || [i < -1]) || [x2' = x2 + 1 + i] && [d'=2])) 
    assert G ([x3 = 10] -> [x2' = 0])

    assume ([x3 = 0])
    assert G (![x4 = 10] -> ([x3' = x3 + 1] && (![d'=3] || [i > 1] || [i < -1]) || [x3' = x3 + 1 + i] && [d'=3])) 
    assert G ([x4 = 10] -> [x3' = 0])

    assume ([x4 = 0])
    assert G (![x5 = 10] -> ([x4' = x4 + 1] && (![d'=4] || [i > 1] || [i < -1]) || [x4' = x4 + 1 + i] && [d'=4])) 
    assert G ([x5 = 10] -> [x4' = 0])

    assume ([x5 = 0])
    assert G (![x6 = 10] -> ([x5' = x5 + 1] && (![d'=5] || [i > 1] || [i < -1]) || [x5' = x5 + 1 + i] && [d'=5])) 
    assert G ([x6 = 10] -> [x5' = 0])

    assume ([x6 = 0])
    assert G (![x7 = 10] -> ([x6' = x6 + 1] && (![d'=6] || [i > 1] || [i < -1]) || [x6' = x6 + 1 + i] && [d'=6])) 
    assert G ([x7 = 10] -> [x6' = 0])

    assume ([x7 = 0])
    assert G (![x8 = 10] -> ([x7' = x7 + 1] && (![d'=7] || [i > 1] || [i < -1]) || [x7' = x7 + 1 + i] && [d'=7])) 
    assert G ([x8 = 10] -> [x7' = 0])

    assume ([x8 = 0])
    assert G (![x9 = 10] -> ([x8' = x8 + 1] && (![d'=8] || [i > 1] || [i < -1]) || [x8' = x8 + 1 + i] && [d'=8])) 
    assert G ([x9 = 10] -> [x8' = 0])

    assume ([x9 = 0])
    assert G (![x10 = 10] -> ([x9' = x9 + 1] && (![d'=9] || [i > 1] || [i < -1]) || [x9' = x9 + 1 + i] && [d'=9])) 
    assert G ([x10 = 10] -> [x9' = 0])

    assume ([x10 = 0])
    assert G ([x10' = x10 + 1] && (![d'=10] || [i > 1] || [i < -1]) || [x10' = x10 + 1 + i] && [d'=10])

    assert F [x0 > 10]
 }
 
