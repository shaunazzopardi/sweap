state int x
state int y
state int z
input int iy
input int iz

game Reachability from work {
    loc work 0
    loc goal 1

    from goal to goal with true
   
    from work to goal with [x <= 0]
   
    from work to work with
        ([y <= 0] && [x' = x - 1] && [y' = iy] && [z' = iz])  
     || ([z <= 0] && [y' = y - 1] && [x' = x] && [z' = iz])
     || ([z' = z - 1] && [x' = x] && [y' = y])


}
