state int x
state int y
state int z
state int u
state int v
input int iy
input int iz
input int iu
input int iv



game Reachability from work {
    loc work 0
    loc goal 1

    from goal to goal with true
   
    from work to goal with [x <= 0]
   
    from work to work with
        ([y <= 0] && [x' = x - 1] && 
         [y' = iy] && [z' = iz] && [u' = iu] && [v' = iv])  
     || ([z <= 0] && [y' = y - 1] && 
         [x' = x] && [z' = iz] && [u' = iu] && [v' = iv])
     || ([u <= 0] && [z' = z - 1] && 
         [x' = x] && [y' = y] && [u' = iu] && [v' = iv])
     || ([v <= 0] && [u' = u - 1] && 
         [x' = x] && [y' = y] && [z' = z] && [v' = iv])
     || ([v' = v - 1] && 
         [x' = x] && [y' = y] && [z' = z] && [u' = u])

}

