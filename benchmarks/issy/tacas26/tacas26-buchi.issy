state int t
state int d
state int b
input int it
input int id


game Buechi from done {
    loc start 0
    loc charge 0
    loc work 0
    loc done 1
    loc err 0

    from done to start with
        ([it >= 0] && [id > 0] && 
         [t' = it] && [d' = id] && [b' = b])

    from done to done with
        ([it < 0] || [id <= 0])
    
    from start to work with
        ([t' = t] && [d' = d] && [b' = b])

    from start to charge with
        ([t' = t] && [d' = d] && [b' = b])
    
    from work to work with
        ([b > 0] && 
         [t' = t - 1] && [b' = b - d] && [d' = d])
   
    from work to done with 
        [t <= 0] && keep(t b d)

    from work to charge with 
        [b > 0] && keep(t b d)

    from work to err with 
        [b <= 0] && keep(t b d)

    from charge to charge with
        [b' = b + 1] && keep(t d)

    from charge to work with 
        [b' = b + 1] && keep(t d)

    from err to err with true

}

