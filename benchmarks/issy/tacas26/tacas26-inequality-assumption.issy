state int x
state int d
input int i

formula{
    assume [x > 0]
    assume F [i  < 0]
    assert F [x <= 0]
}

game Safety from wait {
    loc wait 1
    loc work 1

    
    from wait to wait with keep(x d)
    from wait to work with [d' = i] && keep(x)

    from work to work with
        ([x' = x - d] && [d' = d])  
     || ([x' = x + d] && [d' = d])

}
