state int pos
state int c

input int tasks

formula{

    assert X G ([pos >= 1] && [pos <= 10])
    assert G F [pos = 1]
    assert G F [pos = 2]
    assert G F [pos = 3]
    assert G F [pos = 4]
    assert G F [pos = 5]
    assert G F [pos = 6]
    assert G F [pos = 7]
    assert G F [pos = 8]
    assert G F [pos = 9]
    assert G F [pos = 10]  
}

game Safety from init {
    loc init 1
    loc move 1
    loc service 1

    from init to move with [pos' = 1] && [c' = tasks]

    from move to move with 
       [c <= 0] && [c' = c] &&
       ([pos' = pos + 1] ||  [pos' = pos - 1])

    from move to service with
        [c' = tasks] && [pos' = pos]

    from service to service with
        [c' = c - 1] && [pos' = pos]
    
    from service to move with 
        [c <= 0] && [c' = c] && [pos' = pos]
}    
