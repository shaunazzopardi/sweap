state int x1
state int x2
state int x3
state int x4

state int y

input int i



def goal  = [x1 <= 0] && [x2 <= 0] && [x3 <= 0] && [x4 <= 0]
def reset_X = [x1' = i] && [x2' = i] && [x3' = i] && [x4' = i]
def keep_X = keep(x1 x2 x3 x4)

def update_Y = ([y' = y + 1] || [y' = y - 1])


formula {
     assert G F (goal)
}

game Safety from linit {
    
    loc linit 1
    loc ldone 1
    loc l0 1
    loc l1 1
    loc l2 1
    loc l3 1
    loc l4 1


    from linit to l0 with reset_X

    from l0 to l1 with keep_X && [y' = i]
    from l0 to l2 with keep_X && [y' = i]
    from l0 to l3 with keep_X && [y' = i]
    from l0 to l4 with keep_X && [y' = i]

    from l1 to l1 with !goal && 
                       [x1' = x1 - 1] && 
                       [x2' = x2] && 
                       [x3' = x3] && 
                       [x4' = x4] && 
                       update_Y
    from l1 to l0 with !goal && keep_X && [y >= 0] 
    from l1 to ldone with goal && keep_X

    from l2 to l2 with !goal && 
                       [x2' = x2 - 1] && 
                       [x1' = x1 - i] && 
                       [x3' = x3] && 
                       [x4' = x4] && 
                       update_Y
    from l2 to l0 with !goal && keep_X && [y >= 0]
    from l2 to ldone with goal && keep_X

    from l3 to l3 with !goal && [x3' = x3 - 1] && 
                                [x1' = x1 - i] && 
                                [x2' = x2 - i] && 
                                [x4' = x4] && 
                                update_Y
    from l3 to l0 with !goal && keep_X && [y >= 0]
    from l3 to ldone with goal && keep_X

    from l4 to l4 with !goal && [x4' = x4 - 1] && 
                                [x1' = x1 - i] && 
                                [x2' = x2 - i] && 
                                [x3' = x3 - i] && 
                                update_Y
    from l4 to l0 with !goal && keep_X && [y >= 0]
    from l4 to ldone with goal && keep_X

    from ldone to l0 with reset_X
}


