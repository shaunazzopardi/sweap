state int x
input bool start
input bool stop

formula {
     assert G ([start]  -> F [x >= 3])
}

game Safety from l0 {
    loc l0 1
    loc l1 1
    loc l2 1


    from l0 to l0 with  ![start] && [x' = x]
    from l0 to l1 with   [start] && [x' = 0] 

    from l1 to l1 with ![stop] && [x' = x + 1]
    from l1 to l2 with  [stop] && [x' = x]

    from l2 to l2 with ![start] &&  [x > 0] && [x' = x - 1]
    from l2 to l0 with ![start] && ![x > 0] && [x' = x]
    from l2 to l1 with  [start] && [x' = 0] 

}


