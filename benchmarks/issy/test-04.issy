state int x1
state int x2
state int sched 


formula {
    assume [x1 = 0] && [x2 = 0]
    assert G ([x1 <= 3] && [x2 <= 3])
    assert X G ([sched = 1] || [sched = 2])
}

game Safety from l0 {
    loc l0 1
    loc l1 1
    
    from l0 to l0 with [x1 <= 5] && 
                       ([x1' = x1 + 1] || [sched' = 1] && [x1' = x1  - 2]) 
    from l0 to l1 with [x1 > 5] && [x1' = x1] 
    from l1 to l1 with [x1' = x1] 
}


game Safety from l0 {
    loc l0 1
    loc l1 1
    
    from l0 to l0 with [x2 <= 5] && 
                       ([x2' = x2 + 2] || [sched' = 2] && [x2' = x2 - 1]) 
    from l0 to l1 with [x2 > 5] && [x2' = x2] 
    from l1 to l1 with [x2' = x2] 
}