state int x1
state int x2
state int sched 


formula {
    assert G F ([x1 = 0] && [x2 = 0])
}

game Safety from l0 {
    loc l0 1
    loc l1 1
    loc l2 0


    from l0 to l1 with [x1' = 0]    
    from l1 to l1 with [x1 <= 1] && 
                       ([x1' = x1 + 1] || [sched' = 1] && [x1' = x1 - 2]) 
    from l1 to l2 with [x1 > 1]
    from l2 to l2 with true
}


game Safety from l0 {
    loc l0 1
    loc l1 1
    loc l2 0

    from l0 to l1 with [x2' = 0]
    from l1 to l1 with [x2 <= 1] && 
                       ([x2' = x2 + 2] || [sched' = 2]  && [x2' = x2 - 1]) 
    from l1 to l2 with [x2 > 1]
    from l2 to l2 with true
}