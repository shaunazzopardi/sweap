// Environment moves
input bool e1
input bool e2
input bool e3
input bool e4

// System moves (should only appear as primed next-states)
state bool c1
state bool c2
state bool c3
state bool c4

// Program variables
state int x1
state int x2
state int x3
state int x4
state int x5
state int x6

// Variables to track the location
state bool setvars
state bool move
state bool goal

// Temporal specifcation
formula {
  assert X ( ((G F !(move && e1)) && G F move) -> G F goal )
}

// Program arena as a safety game
game Safety from init_location {
  loc init_location 1
  loc unsafe_sink 0
  loc setvars 1
  loc move 1
  loc goal 1

// Init variables and go to inital state
  from init_location to setvars with
    setvars'
    && (!move')
    && (!goal')
    && [x1' = 0]
    && [x2' = 0]
    && [x3' = 0]
    && [x4' = 0]
    && [x5' = 0]
    && [x6' = 0]

  from setvars to setvars with
    setvars' 
    && (!move')
    && (!goal')
  && (false
    || ( // setvars -> setvars [!e1 && !e2 && !e3 && !e4 $ x1 := x1 + 1]
         !e1 && !e2 && !e3 && !e4 
      && [x1' = ( x1 + 1)]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // setvars -> setvars [!e1 && !e2 && !e3 && e4 $ x1 := x1 - 1]
         !e1 && !e2 && !e3 && e4 
      && [x1' = ( x1 - 1)]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // setvars -> setvars [!e1 && !e2 && e3 && !e4 $ x2 := x2 + 1]
         !e1 && !e2 && e3 && !e4 
      && [x1' = x1]
      && [x2' = ( x2 + 1)]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // setvars -> setvars [!e1 && !e2 && e3 && e4 $ x2 := x2 - 1]
         !e1 && !e2 && e3 && e4 
      && [x1' = x1]
      && [x2' = ( x2 - 1)]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // setvars -> setvars [!e1 && e2 && !e3 && !e4 $ x3 := x3 + 1]
         !e1 && e2 && !e3 && !e4 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = ( x3 + 1)]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // setvars -> setvars [!e1 && e2 && !e3 && e4 $ x3 := x3 - 1]
         !e1 && e2 && !e3 && e4 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = ( x3 - 1)]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // setvars -> setvars [!e1 && e2 && e3 && !e4 $ x4 := x4 + 1]
         !e1 && e2 && e3 && !e4 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = ( x4 + 1)]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // setvars -> setvars [!e1 && e2 && e3 && e4 $ x4 := x4 - 1]
         !e1 && e2 && e3 && e4 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = ( x4 - 1)]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // setvars -> setvars [e1 && !e2 && !e3 && !e4 $ x5 := x5 + 1]
         e1 && !e2 && !e3 && !e4 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = ( x5 + 1)]
      && [x6' = x6]
    )
    || ( // setvars -> setvars [e1 && !e2 && !e3 && e4 $ x5 := x5 - 1]
         e1 && !e2 && !e3 && e4 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = ( x5 - 1)]
      && [x6' = x6]
    )
    || ( // setvars -> setvars [e1 && !e2 && e3 && !e4 $ x6 := x6 + 1]
         e1 && !e2 && e3 && !e4 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = ( x6 + 1)]
    )
    || ( // setvars -> setvars [e1 && !e2 && e3 && e4 $ x6 := x6 - 1]
         e1 && !e2 && e3 && e4 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = ( x6 - 1)]
    )
    || ( // setvars -> setvars [e1 && e2 && !e3 && !e4 $ x6 := x6 - 1]
         e1 && e2 && !e3 && !e4 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = ( x6 - 1)]
    )
    || ( // setvars -> setvars [e1 && e2 && !e3 && e4 $ x6 := x6 - 1]
         e1 && e2 && !e3 && e4 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = ( x6 - 1)]
    )
    || ( // setvars -> setvars [e1 && e2 && e3 && !e4]
         e1 && e2 && e3 && !e4
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
  )

  from setvars to move with
    move' 
    && (!setvars')
    && (!goal')
  && (false
    || ( // setvars -> move [e1 && e2 && e3 && e4]
         e1 && e2 && e3 && e4
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
  )

  from move to move with
    move' 
    && (!setvars')
    && (!goal')
  && (false
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && !c1 && !c2 && !c3 && !c4 $ x1 := x1 + 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && !c1' && !c2' && !c3' && !c4' 
      && [x1' = ( x1 + 1)]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && !c1 && !c2 && !c3 && c4 $ x1 := x1 - 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && !c1' && !c2' && !c3' && c4' 
      && [x1' = ( x1 - 1)]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && !c1 && !c2 && c3 && !c4 $ x2 := x2 + 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && !c1' && !c2' && c3' && !c4' 
      && [x1' = x1]
      && [x2' = ( x2 + 1)]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && !c1 && !c2 && c3 && c4 $ x2 := x2 - 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && !c1' && !c2' && c3' && c4' 
      && [x1' = x1]
      && [x2' = ( x2 - 1)]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && !c1 && c2 && !c3 && !c4 $ x3 := x3 + 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && !c1' && c2' && !c3' && !c4' 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = ( x3 + 1)]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && !c1 && c2 && !c3 && c4 $ x3 := x3 - 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && !c1' && c2' && !c3' && c4' 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = ( x3 - 1)]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && !c1 && c2 && c3 && !c4 $ x4 := x4 + 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && !c1' && c2' && c3' && !c4' 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = ( x4 + 1)]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && !c1 && c2 && c3 && c4 $ x4 := x4 - 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && !c1' && c2' && c3' && c4' 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = ( x4 - 1)]
      && [x5' = x5]
      && [x6' = x6]
    )
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && c1 && !c2 && !c3 && !c4 $ x5 := x5 + 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && c1' && !c2' && !c3' && !c4' 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = ( x5 + 1)]
      && [x6' = x6]
    )
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && c1 && !c2 && !c3 && c4 $ x5 := x5 - 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && c1' && !c2' && !c3' && c4' 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = ( x5 - 1)]
      && [x6' = x6]
    )
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && c1 && !c2 && c3 && !c4 $ x6 := x6 + 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && c1' && !c2' && c3' && !c4' 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = ( x6 + 1)]
    )
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && c1 && !c2 && c3 && c4 $ x6 := x6 - 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && c1' && !c2' && c3' && c4' 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = ( x6 - 1)]
    )
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && c1 && c2 && !c3 && !c4 $ x6 := x6 - 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && c1' && c2' && !c3' && !c4' 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = ( x6 - 1)]
    )
    || ( // move -> move [!e1 && !(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && c1 && c2 && !c3 && c4 $ x6 := x6 - 1]
         !e1 && !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && c1' && c2' && !c3' && c4' 
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = ( x6 - 1)]
    )
    || ( // move -> move [!(x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0) && (e1 || (c1 && c2 && c3 && !c4))]
         !([x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]) && (e1 || (c1' && c2' && c3' && !c4'))
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
  )

  from move to goal with
    goal' 
    && (!setvars')
    && (!move')
  && (false
    || ( // move -> goal [x1 = 0 && x2 = 0 && x3 = 0 && x4 = 0 && x5 = 0 && x6 = 0]
         [x1 = 0] && [x2 = 0] && [x3 = 0] && [x4 = 0] && [x5 = 0] && [x6 = 0]
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
  )

  from goal to setvars with
    setvars' 
    && (!move')
    && (!goal')
  && (false
    || ( // goal -> setvars []
         true
      && [x1' = x1]
      && [x2' = x2]
      && [x3' = x3]
      && [x4' = x4]
      && [x5' = x5]
      && [x6' = x6]
    )
  )


// Ensure not-blocking
  from setvars to unsafe_sink with true
  from move to unsafe_sink with true
  from goal to unsafe_sink with true
  from unsafe_sink to unsafe_sink with true
}
