input bool i1
input bool i2
state int x1
state int x2
state bool active1
state bool active2
state int sched 


formula {
    assert G F ([active1] && [active2])
    assert X G ([sched = 1] || [sched = 2])
}

game Safety from l0 {
    loc l0 1
    loc l1 1
    loc l2 1


    from l0 to l1 with [x1' = 0]    
    from l1 to l1 with [x1 <= 1] && 
                       ([x1' = x1 + 1] || 
                       ([sched' = 1] || i1) && [x1' = x1 - 2]) &&
                       [active1' = true]
    from l1 to l2 with [x1 > 1]
    from l2 to l2 with [active1' = false] 
}


game Safety from l0 {
    loc l0 1
    loc l1 1
    loc l2 1

    from l0 to l1 with [x2' = 0]
    from l1 to l1 with [x2 <= 1] && 
                       ([x2' = x2 + 2] || 
                       ([sched' = 2] || i2) && [x2' = x2 - 1]) &&
                       [active2' = true]
    from l1 to l2 with [x2 > 1]
    from l2 to l2 with [active2' = false]
}