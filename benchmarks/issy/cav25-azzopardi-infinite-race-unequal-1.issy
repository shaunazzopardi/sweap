// Environment moves
input bool ince

// System moves (should only appear as primed next-states)
state bool incc

// Program variables
state int e
state int c

// Variables to track the location
state bool q
state bool q1
state bool q2

// Temporal specifcation
formula {
  assert X ( ((G F !ince)) -> (G F (q && [c > e])) )
}

// Program arena as a safety game
game Safety from init_location {
  loc init_location 1
  loc unsafe_sink 0
  loc q 1
  loc q1 1
  loc q2 1

// Init variables and go to inital state
  from init_location to q with
    q'
    && (!q1')
    && (!q2')
    && [e' = 0]
    && [c' = 0]

  from q to q with
    q' 
    && (!q1')
    && (!q2')
  && (false
    || ( // q -> q [ince $ e := e + 1]
         ince 
      && [e' = ( e + 1)]
      && [c' = c]
    )
  )

  from q to q1 with
    q1' 
    && (!q')
    && (!q2')
  && (false
    || ( // q -> q1 [!ince]
         !ince
      && [e' = e]
      && [c' = c]
    )
  )

  from q1 to q with
    q' 
    && (!q1')
    && (!q2')
  && (false
    || ( // q1 -> q [!incc]
         !incc'
      && [e' = e]
      && [c' = c]
    )
  )

  from q1 to q2 with
    q2' 
    && (!q')
    && (!q1')
  && (false
    || ( // q1 -> q2 [incc && !ince $ c := c + 2]
         incc' && !ince 
      && [e' = e]
      && [c' = ( c + 2)]
    )
  )

  from q2 to q1 with
    q1' 
    && (!q')
    && (!q2')
  && (false
    || ( // q2 -> q1 [ $ c := c - 1]
         true
      && [e' = e]
      && [c' = ( c - 1)]
    )
  )


// Ensure not-blocking
  from q to unsafe_sink with true
  from q1 to unsafe_sink with true
  from q2 to unsafe_sink with true
  from unsafe_sink to unsafe_sink with true
}
