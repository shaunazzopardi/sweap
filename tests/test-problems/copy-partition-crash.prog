program copy_partition_crash {
    STATES { run : init }
    ENVIRONMENT EVENTS { }
    CONTROLLER EVENTS { }
    VALUATION {
        a : integer;
        b : integer;
        c : integer;
        d : integer;
        e : integer;
        f : integer;
        g : integer;
        h : integer;
        i : integer;
    }
    TRANSITIONS [completion=stutter] {
        run -> run [TRUE $ a := b; b := c; c := d; d := e; e := f; f := f; g := h; h := i; i := i]
    }
    SPECIFICATION { F(a <= 0) }
}
